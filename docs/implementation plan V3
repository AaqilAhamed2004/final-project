```java
package com.aura.security;

/**
 * Thread-local storage for the current request's tenant ID.
 * Set by JwtAuthFilter (for authenticated requests) or TenantFilter (for public requests).
 * Read by all service methods to scope database queries.
 *
 * IMPORTANT: Always call clear() in a finally block to prevent tenant leakage
 * between requests in the same thread (servlet thread pool reuse).
 */
public class TenantContext {
    private static final ThreadLocal<String> currentTenant = new ThreadLocal<>();

    public static void setTenantId(String tenantId) {
        currentTenant.set(tenantId);
    }

    public static String getTenantId() {
        return currentTenant.get();
    }

    public static void clear() {
        currentTenant.remove();
    }
}
```

